# Firebase project and registered Web app (the API key is public Firebase config).
FIREBASE_PROJECT_ID=replace-me
FIREBASE_API_KEY=replace-me
FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
FIREBASE_APP_ID=replace-me

# Cloudflare R2 S3-compatible credentials. Keep the bucket private.
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=replace-me
R2_ENDPOINT=https://replace-me.eu.r2.cloudflarestorage.com

# Stripe one-time credit pack Price IDs (minutes are configured server-side).
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me
STRIPE_PRICE_60_MINUTES=price_replace-me
STRIPE_CREDIT_PACKS={"60":{"price_id":"price_replace-me","minutes":60}}

# Analysis workers use this key to call the OpenAI Decisions API.
OPENAI_API_KEY=replace-me

APP_BASE_URL=http://localhost:8000
MAX_UPLOAD_BYTES=5368709120
MAX_RESERVED_MINUTES=180
MODEL_BUDGET_USD=5
ANALYSIS_CONCURRENCY=4
# Optimized pipeline is the default for new analyses; 1 rolls back new runs.
ANALYSIS_PIPELINE_VERSION=2
# Grouped-request test: eight adjacent windows share each base request.
# Set 1 for the original individual requests, or 4 for smaller groups.
ANALYSIS_GROUP_WINDOWS=8
# Default refinement: consolidate candidates and inspect one second of evidence.
ANALYSIS_CANDIDATE_REFINEMENT=true
ANALYSIS_REFINEMENT_FRAMES=9
ANALYSIS_RESCUE_THRESHOLD=0.05
ANALYSIS_RESCUE_MISSED=false
ANALYSIS_RESCUE_MAX_REQUESTS=0
# Enable after comparing original-source sampling and preview output in staging.
ANALYSIS_DIRECT_SOURCE=false
ANALYSIS_TIMESTAMP_DECODER=true
# New runs pin these settings; old saved runs retain the old scheduler/decoder.
ANALYSIS_PREFETCH_REQUESTS=4
ANALYSIS_ROLLING_SCHEDULER=false
ANALYSIS_CHRONOLOGICAL_EVIDENCE=true
ANALYSIS_DECODER_THREAD_TYPE=AUTO
ANALYSIS_DECODER_THREADS=2
ANALYSIS_OVERLAP_PREVIEW_UPLOADS=true
# Set BOTH to the project's observed Decisions RPM/TPM limits to coordinate games.
# Zero disables distributed allowance; per-worker response-header pacing remains.
ANALYSIS_RATE_RPM=0
ANALYSIS_RATE_TPM=0
# Cost estimates only: keep these aligned with deployed Cloud Run resources/rates.
WORKER_CPU=2
WORKER_MEMORY_GIB=8
WORKER_CPU_USD_PER_SECOND=0.000018
WORKER_MEMORY_USD_PER_SECOND=0.000002

# Cloud Run Jobs and Cloud Tasks (near the eur3 Firestore multi-region).
GCP_PROJECT_ID=replace-me
GCP_REGION=europe-west1
GCP_RUN_JOB=highlights-worker
GCP_TASKS_LOCATION=europe-west1
GCP_TASKS_QUEUE=highlights-dispatch
DISPATCH_URL=https://your-app.example.com/internal/dispatch
DISPATCH_SERVICE_ACCOUNT=highlights-tasks@your-project.iam.gserviceaccount.com
INTERNAL_AUDIENCE=https://your-app.example.com

# Enable only after /internal/media/migrate has completed and a separate verify pass succeeded.
MEDIA_CLEANUP_ENABLED=false

# Subscription rollout: remain disabled until migration and staging verification.
SUBSCRIPTIONS_ENABLED=false
# Temporarily blocks API mutations/webhooks while existing jobs drain for migration.
BILLING_MIGRATION_MODE=false
# Mode must match the key, Prices, Portal and webhook. Live activation requires a verified account transition.
STRIPE_MODE=test
STRIPE_LIVE_ENABLED=false
# Billing uses API version 2025-04-30.basil.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_TOPUP=
STRIPE_PORTAL_CONFIGURATION_ID=
